<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="hri_hand" params="prefix parent reflect mesh_dir *origin">
    
    <xacro:property name="motor_x" value="0.016" />
    <xacro:property name="motor_y" value="0.035" />
    <xacro:property name="motor_z" value="0.02" />
    <xacro:property name="pris_x" value="0.005" />
    <xacro:property name="pris_y" value="0.005" />
    <xacro:property name="pris_z" value="0.025" />

    <xacro:property name="knucle_mass" value="0.010" />
    <xacro:property name="MCP_mass" value="0.0125" />
    <xacro:property name="PIP_mass" value="0.0125" />
    <xacro:property name="DIP_mass" value="0.0025" />
    <xacro:property name="motor_mass" value="0.015" />
    <xacro:property name="safe_dummy_mass" value="0.015" />

    <xacro:property name="motor_joint_x" value="0.0" />
    <xacro:property name="motor_joint_y" value="-0.0145" />
    <xacro:property name="motor_joint_z" value="0.006" />

    <xacro:property name="eef_offset_z" value="0.025725" />
    <xacro:property name="motor_max_upper" value="0.0103" />
    
    <link name="${prefix}wrist_plate">
      <visual>
        <geometry><mesh filename="${mesh_dir}/${prefix}f03_al_link_hand_wrist_part.stl" scale="1.0 1.0 1.0"/></geometry>
        <origin xyz="0.0 0.0 0.0" rpy="${1.57 * reflect} 0.0 0.0"/>
        <material name="white"><color rgba="0.85 0.85 0.85 1"/></material>      
      </visual>
      <collision>
        <geometry><box size="0.04 0.04 0.01"/></geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.015"/>
        <inertia ixx="1.0e-05" ixy="0.0" ixz="0.0" iyy="1.0e-05" iyz="0.0" izz="1.0e-05" />
      </inertial>
    </link>

    <joint name="${prefix}wrist_plate_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}"/>
      <child link="${prefix}wrist_plate"/>
    </joint>

    <link name="${prefix}hand_palm">
      <visual>
        <geometry><mesh filename="${mesh_dir}/${prefix}f03_al_palm.stl" scale="1.0 1.0 1.0"/></geometry>
        <origin xyz="0.0 ${0.0162 * reflect} 0.030" rpy="${3.14 * reflect} 4.71 0.0"/>
        <material name="lightgrey"><color rgba="0.5 0.5 0.5 1.0"/></material>
      </visual>
      <collision>
        <geometry><box size="0.09 0.03 0.06"/></geometry>
        <origin xyz="0.0 ${0.0162 * reflect} 0.030" rpy="0 0 0"/>
      </collision>
      <inertial>
        <mass value="0.09"/>
        <inertia ixx="1.0e-03" ixy="0.0" ixz="0.0" iyy="1.0e-03" iyz="0.0" izz="1.0e-03" />
      </inertial>
    </link>

    <joint name="${prefix}hand_wrist_plate_to_hand_palm" type="fixed">
      <parent link="${prefix}wrist_plate"/>
      <child link="${prefix}hand_palm"/>
      <origin xyz="0 0 .026"/>
    </joint>

    <xacro:macro name="finger_assembly" params="finger_name x_offset">
      
      <link name="${prefix}knuckle_${finger_name}">
        <visual>
          <geometry><mesh filename="${mesh_dir}/${prefix}f03_finger_base.stl" scale="1.0 1.0 1.0"/></geometry>
          <origin xyz="0.0 0.0 0.0" rpy="0.0 -1.57 ${-3.14 * reflect}"/>
          <material name="white"/>
        </visual>
        <inertial>
          <mass value="${knucle_mass}"/>
          <inertia ixx="1.0e-05" ixy="0.0" ixz="0.0" iyy="1.0e-05" iyz="0.0" izz="1.0e-05" />
        </inertial>
      </link>
      <joint name="${prefix}knuckle_${finger_name}_joint" type="fixed">
        <parent link="${prefix}hand_palm"/>
        <child link="${prefix}knuckle_${finger_name}"/>
        <origin xyz="${-0.0313 + x_offset} ${0.0160 * reflect} 0.0295"/>
      </joint>

      <link name="${prefix}${finger_name}_MCP">
        <visual><geometry><mesh filename="${mesh_dir}/${prefix}f03_al_link_mcp.stl" scale="1.0 1.0 1.0"/></geometry><origin xyz="0.0 ${0.00415 * reflect} -0.00955" rpy="0.0 -1.57 ${3.14 * reflect}"/><material name="white"/></visual>
        <collision><geometry><box size="0.015 0.015 0.035"/></geometry><origin xyz="0.0 0.0 0.015" rpy="0 0 0"/></collision>
        <inertial><mass value="${MCP_mass}"/><inertia ixx="1.0e-05" ixy="0.0" ixz="0.0" iyy="1.0e-05" iyz="0.0" izz="1.0e-05" /></inertial>
      </link>
      <joint name="${prefix}${finger_name}_MCP_joint" type="revolute">
        <axis xyz="-1 0 0"/>
        <limit effort="3.0" lower="0.0" upper="1.3" velocity="1.0"/>
        <dynamics damping="0.5" friction="0.1"/>
        <parent link="${prefix}knuckle_${finger_name}"/><child link="${prefix}${finger_name}_MCP"/>
        <origin xyz="-0.0002 ${-0.00677 * reflect} 0.0538"/>
        <mimic joint="${prefix}pris_${finger_name}_joint" multiplier="100.00" offset="0.0" />
      </joint>

      <link name="${prefix}${finger_name}_PIP">
        <visual><geometry><mesh filename="${mesh_dir}/${prefix}f03_al_link_pip.stl" scale="1.0 1.0 1.0"/></geometry><origin xyz="-0.0002 ${0.0093 * reflect} -0.00242" rpy="0.0 -1.57 ${3.14 * reflect}"/><material name="white"/></visual>
        <collision><geometry><box size="0.012 0.012 0.025"/></geometry><origin xyz="0.0 0.0 0.01" rpy="0 0 0"/></collision>
        <inertial><mass value="${PIP_mass}"/><inertia ixx="1.0e-05" ixy="0.0" ixz="0.0" iyy="1.0e-05" iyz="0.0" izz="1.0e-05" /></inertial>
      </link>
      <joint name="${prefix}${finger_name}_PIP_joint" type="revolute">
        <axis xyz="-1 0 0"/>
        <limit effort="3.0" lower="0.0" upper="1.0" velocity="1.0"/>
        <dynamics damping="0.5" friction="0.1"/>
        <parent link="${prefix}${finger_name}_MCP"/><child link="${prefix}${finger_name}_PIP"/>
        <origin xyz="0.0 ${-0.00208 * reflect} 0.02677"/>
        <mimic joint="${prefix}pris_${finger_name}_joint" multiplier="100.00" offset="0.0" />
      </joint>

      <link name="${prefix}${finger_name}_DIP">
        <visual><geometry><mesh filename="${mesh_dir}/${prefix}f03_al_link_dip.stl" scale="1.0 1.0 1.0"/></geometry><origin xyz="0.0 ${0.0075 * reflect} -0.0025" rpy="0.0 -1.57 ${3.14 * reflect}"/><material name="lightyellow"><color rgba="1.0 1.0 0.3 1.0"/></material></visual>
        <collision><geometry><box size="0.01 0.01 0.02"/></geometry><origin xyz="0.0 0.0 0.01" rpy="0 0 0"/></collision>
        <inertial><mass value="${DIP_mass}"/><inertia ixx="1.0e-06" ixy="0.0" ixz="0.0" iyy="1.0e-06" iyz="0.0" izz="1.0e-06" /></inertial>
      </link>
      <joint name="${prefix}${finger_name}_DIP_joint" type="revolute">
        <axis xyz="-1 0 0"/>
        <limit effort="3.0" lower="0.0" upper="1.0" velocity="1.0"/>
        <dynamics damping="0.5" friction="0.1"/>
        <parent link="${prefix}${finger_name}_PIP"/><child link="${prefix}${finger_name}_DIP"/>
        <origin xyz="0.0 0.0 0.0233"/>
        <mimic joint="${prefix}pris_${finger_name}_joint" multiplier="100.00" offset="0.0" />
      </joint>

      <link name="${prefix}ee_${finger_name}_link">
        <inertial>
          <mass value="0.001"/>
          <inertia ixx="1.0e-07" ixy="0.0" ixz="0.0" iyy="1.0e-07" iyz="0.0" izz="1.0e-07" />
        </inertial>
      </link>
      <joint name="${prefix}ee_${finger_name}_joint" type="fixed">
        <parent link="${prefix}${finger_name}_DIP"/><child link="${prefix}ee_${finger_name}_link"/>
        <origin xyz="0.0 0.0 ${eef_offset_z}" rpy="0.0 0.0 0.0"/>
      </joint>

      <link name="${prefix}motor_${finger_name}">
        <visual><geometry><box size="${motor_x} ${motor_y} ${motor_z}"/></geometry><origin xyz="0 ${0.02 * reflect} 0"/><material name="black"><color rgba="0.25 0.25 0.25 1"/></material></visual>
        <inertial><mass value="${motor_mass}"/><inertia ixx="1.0e-05" ixy="0.0" ixz="0.0" iyy="1.0e-05" iyz="0.0" izz="1.0e-05" /></inertial>
      </link>
      <joint name="${prefix}motor_${finger_name}_joint" type="fixed">
        <parent link="${prefix}knuckle_${finger_name}"/><child link="${prefix}motor_${finger_name}"/>
        <origin xyz="${motor_joint_x} ${motor_joint_y * reflect} ${motor_joint_z}" rpy="1.57 0 0"/>
      </joint>

      <link name="${prefix}pris_${finger_name}">
        <visual><geometry><box size="${pris_x} ${pris_y} ${pris_z}"/></geometry><origin xyz="0 0 0"/><material name="black"/></visual>
        <inertial><mass value="${safe_dummy_mass}"/><inertia ixx="1.0e-05" ixy="0.0" ixz="0.0" iyy="1.0e-05" iyz="0.0" izz="1.0e-05" /></inertial>
      </link>
      <joint name="${prefix}pris_${finger_name}_joint" type="prismatic">
        <axis xyz="0 0 -1"/><limit effort="3.0" lower="0.0" upper="${motor_max_upper}" velocity="0.1"/>
        <parent link="${prefix}motor_${finger_name}"/><child link="${prefix}pris_${finger_name}"/>
        <origin xyz="0.0 ${(motor_joint_y + 0.0445) * reflect} 0.0" rpy="${1.57 * reflect} 0 0"/>
      </joint>
    </xacro:macro>

    <xacro:finger_assembly finger_name="index"  x_offset="0.0" />
    <xacro:finger_assembly finger_name="middle" x_offset="0.0210" />
    <xacro:finger_assembly finger_name="ring"   x_offset="0.0420" />
    <xacro:finger_assembly finger_name="little" x_offset="0.0630" />

    <link name="${prefix}knuckle_thumb">
      <visual>
        <geometry><mesh filename="${mesh_dir}/${prefix}f03_thumb_base.stl" scale="1.0 1.0 1.0"/></geometry>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 ${-3.14 * reflect}"/>
        <material name="white"/>
      </visual>
      <inertial><mass value="${knucle_mass}"/><inertia ixx="1.0e-05" ixy="0.0" ixz="0.0" iyy="1.0e-05" iyz="0.0" izz="1.0e-05" /></inertial>
    </link>
    <joint name="${prefix}knuckle_thumb_joint" type="fixed">
      <parent link="${prefix}hand_palm"/><child link="${prefix}knuckle_thumb"/>
      <origin xyz="0.0345 ${0.0162 * reflect} 0.0186"/>
    </joint>

    <link name="${prefix}thumb_joint">
      <visual><geometry><mesh filename="${mesh_dir}/${prefix}f03_thumb_joint.stl" scale="1.0 1.0 1.0"/></geometry><origin xyz="0 0 -0.005" rpy="0 0 ${3.14 * reflect}"/><material name="white"/></visual>
      <collision><geometry><box size="0.015 0.015 0.02"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
      <inertial><mass value="${motor_mass}"/><inertia ixx="1.0e-05" ixy="0.0" ixz="0.0" iyy="1.0e-05" iyz="0.0" izz="1.0e-05" /></inertial>
    </link>
    <joint name="${prefix}thumb_jo_joint" type="revolute">
      <axis xyz="0 0 -1"/>
      <limit effort="3.0" lower="0.0" upper="1.8" velocity="1.0"/>
      <dynamics damping="0.5" friction="0.1"/>
      <parent link="${prefix}knuckle_thumb"/><child link="${prefix}thumb_joint"/>
      <origin xyz="-0.0558 ${-0.00675 * reflect} 0.0" rpy="0.0 0.0 ${-0.6021 * reflect}" />
      <mimic joint="${prefix}pris_thumb_jo_joint" multiplier="100.00" offset="0.0" />
    </joint>

    <link name="${prefix}thumb_MCP">
      <visual><geometry><mesh filename="${mesh_dir}/${prefix}f03_al_link_mcp.stl" scale="1.0 1.0 1.0"/></geometry><origin xyz="0.00955 0.0 0.00415" rpy="${-1.57 * reflect} 0 ${3.14 * reflect}"/><material name="white"/></visual>
      <collision><geometry><box size="0.015 0.015 0.035"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
      <inertial><mass value="${MCP_mass}"/><inertia ixx="1.0e-05" ixy="0.0" ixz="0.0" iyy="1.0e-05" iyz="0.0" izz="1.0e-05" /></inertial>
    </link>
    <joint name="${prefix}thumb_MCP_joint" type="revolute">
      <axis xyz="0 1 0"/>
      <limit effort="3.0" lower="0.0" upper="1.0" velocity="1.0"/>
      <dynamics damping="0.5" friction="0.1"/>
      <parent link="${prefix}thumb_joint"/><child link="${prefix}thumb_MCP"/>
      <origin xyz="-0.031 ${-0.0055 * reflect} 0.0" rpy="0.0 0.4538 0.0"/>
      <mimic joint="${prefix}pris_thumb_DIP_joint" multiplier="100.00" offset="0.0" />
    </joint>

    <link name="${prefix}thumb_DIP">
      <visual><geometry><mesh filename="${mesh_dir}/${prefix}f03_al_link_dip.stl" scale="1.0 1.0 1.0"/></geometry><origin xyz="0.00255 0.0 0.00726" rpy="${-1.57 * reflect} 0 ${3.14 * reflect}"/><material name="lightyellow"><color rgba="1.0 1.0 0.3 1.0"/></material></visual>
      <collision><geometry><box size="0.01 0.01 0.02"/></geometry><origin xyz="0 0 0" rpy="0 0 0"/></collision>
      <inertial><mass value="${DIP_mass}"/><inertia ixx="1.0e-06" ixy="0.0" ixz="0.0" iyy="1.0e-06" iyz="0.0" izz="1.0e-06" /></inertial>
    </link>
    <joint name="${prefix}thumb_DIP_joint" type="revolute">
      <axis xyz="0 1 0"/>
      <limit effort="3.0" lower="0.0" upper="0.8" velocity="1.0"/>
      <dynamics damping="0.5" friction="0.1"/>
      <parent link="${prefix}thumb_MCP"/><child link="${prefix}thumb_DIP"/>
      <origin xyz="-0.0298 0.0 -0.0042" rpy="0.0 0.0 0.0"/>
      <mimic joint="${prefix}pris_thumb_DIP_joint" multiplier="100.00" offset="0.0" />
    </joint>

    <link name="${prefix}ee_thumb_link">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1.0e-07" ixy="0.0" ixz="0.0" iyy="1.0e-07" iyz="0.0" izz="1.0e-07" />
      </inertial>
    </link>
    <joint name="${prefix}ee_th_joint" type="fixed">
      <parent link="${prefix}thumb_DIP"/><child link="${prefix}ee_thumb_link"/>
      <origin xyz="${-eef_offset_z} 0.0 0.0 " rpy="0.0 0.0 0.0"/>
    </joint>

    <link name="${prefix}motor_thumb_jo">
      <visual><geometry><box size="${motor_x} ${motor_y} ${motor_z}"/></geometry><origin xyz="0 ${0.02 * reflect} 0"/><material name="black"/></visual>
      <inertial><mass value="${motor_mass}"/><inertia ixx="1.0e-05" ixy="0.0" ixz="0.0" iyy="1.0e-05" iyz="0.0" izz="1.0e-05" /></inertial>
    </link>
    <joint name="${prefix}motor_thumb_jo_joint" type="fixed">
      <parent link="${prefix}knuckle_thumb"/><child link="${prefix}motor_thumb_jo"/>
      <origin xyz="-0.008 ${-0.015 * reflect} 0.0" rpy="${1.57 * reflect} -1.57 0"/>
    </joint>
    <link name="${prefix}pris_thumb_jo">
      <visual><geometry><box size="${pris_x} ${pris_y} ${pris_z}"/></geometry><origin xyz="0 0 0"/><material name="black"/></visual>
      <inertial><mass value="${safe_dummy_mass}"/><inertia ixx="1.0e-05" ixy="0.0" ixz="0.0" iyy="1.0e-05" iyz="0.0" izz="1.0e-05" /></inertial>
    </link>
    <joint name="${prefix}pris_thumb_jo_joint" type="prismatic">
      <axis xyz="0 0 -1"/><limit effort="3.0" lower="0.0" upper="${motor_max_upper}" velocity="0.1"/>
      <parent link="${prefix}motor_thumb_jo"/><child link="${prefix}pris_thumb_jo"/>
      <origin xyz="0.0 ${-0.015 * reflect} 0.0" rpy="${1.57 * reflect} 0 0"/>
    </joint>

    <link name="${prefix}motor_thumb_DIP">
      <visual><geometry><box size="${motor_x} ${motor_y} ${motor_z}"/></geometry><origin xyz="0 ${0.02 * reflect} 0"/><material name="black"/></visual>
      <inertial><mass value="${DIP_mass}"/><inertia ixx="1.0e-06" ixy="0.0" ixz="0.0" iyy="1.0e-06" iyz="0.0" izz="1.0e-06" /></inertial>
    </link>
    <joint name="${prefix}motor_thumb_DIP_joint" type="fixed">
      <parent link="${prefix}thumb_joint"/><child link="${prefix}motor_thumb_DIP"/>
      <origin xyz="0.0125 ${-0.0055 * reflect} -0.015" rpy="3.14 3.14 ${-1.57 * reflect}"/>
    </joint>
    <link name="${prefix}pris_thumb_DIP">
      <visual><geometry><box size="${pris_x} ${pris_y} ${pris_z}"/></geometry><origin xyz="0 0 0"/><material name="black"/></visual>
      <inertial><mass value="${safe_dummy_mass}"/><inertia ixx="1.0e-05" ixy="0.0" ixz="0.0" iyy="1.0e-05" iyz="0.0" izz="1.0e-05" /></inertial>
    </link>
    <joint name="${prefix}pris_thumb_DIP_joint" type="prismatic">
      <axis xyz="0 0 -1"/><limit effort="3.0" lower="0.0" upper="${motor_max_upper}" velocity="0.1"/>
      <parent link="${prefix}motor_thumb_DIP"/><child link="${prefix}pris_thumb_DIP"/>
      <origin xyz="0.0 ${-0.015 * reflect} 0.0" rpy="${1.57 * reflect} 0 0"/>
    </joint>

  </xacro:macro>
</robot>